# --- build output ------------------------------------------------------------

/target
apple/.build/

# --- generated, never edited --------------------------------------------------

# Emitted by apple/scripts/build-core.sh on every build. Regenerate, never edit.
apple/Sources/Zer0Core/zer0_core.swift
apple/Sources/Zer0CoreFFI/

# The app icon is generated by apple/scripts/make-icon.sh, but it is committed
# on purpose: building zer0 must not require ImageMagick. The SVGs it is made
# from are the source and are committed too.
!apple/Resources/AppIcon.icns

# --- design renders -----------------------------------------------------------

# Screenshot harnesses (ZER0_SHOT=1 swift test --filter ZZ) write PNGs here so
# a person can look at a screen on a machine with no screen. They are how most
# of this interface's defects were found, and they are worth keeping — in a
# working tree, not in history. They regenerate from the code they picture, so
# a committed one is a screenshot that can go stale while looking authoritative,
# and 8 MB of them is what one night of design work already produced.
#
# An ADR that wants to show a screen names the command that draws it.
design/**/*.png

# The marks themselves are source, not output: hand-written geometry that
# nothing regenerates.
!design/logo/*.svg

# --- secrets, and anything that is somebody's browsing ------------------------

# Chat/AI config is a file on purpose, so it can be version-controlled — but
# only in the person's own dotfiles, never here, and API tokens live in the
# Keychain rather than in it. A stray copy in this tree is how a key reaches a
# public repository.
config.toml
# Cargo's config is a build file, not a secret: it pins the deployment target
# the bundled SQLite is compiled for. The rule above would catch it.
!.cargo/config.toml
.env
*.pem
*.key

# The session: tabs, history, downloads, extension consent. Never anyone's.
*.sqlite
*.sqlite-wal
*.sqlite-shm
icons.sqlite*

# --- fetched dependencies -----------------------------------------------------

# WebKit source and build land in ~/.cache/zer0/webkit by default, and
# libchrondb in ~/.chrondb — both outside the repository. These cover the case
# where someone points ZER0_WEBKIT_DIR at a directory in here.
/WebKitBuild/
/webkit/
*.dylib
*.a

# --- macOS and Xcode ----------------------------------------------------------

.DS_Store
DerivedData/
*.xcuserstate
xcuserdata/
.swiftpm/

# --- tooling that passes through ----------------------------------------------

# Left behind by tools run against this tree rather than by the project itself.
.ruff_cache/
.playwright-mcp/
*.profraw
*.log

scripts/commit-history.sh
